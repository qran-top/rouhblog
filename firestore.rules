rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (required)
    //   - email: string (required)
    //   - role: string (required, ['admin', 'editor', 'user'])
    //
    // Collection: reflections
    // Document ID: {reflectionId}
    // Fields:
    //   - verseRef: string (required)
    //   - entries: list of objects {question: string, answer: string} (required)
    //   - authorId: string (required)
    //   - authorName: string (required)
    //   - createdAt: timestamp (required)
    //   - isPublic: bool (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "amerawad111@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    function isValidUser(data) {
      let fields = ['uid', 'displayName', 'email', 'role'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&
             data.uid is string && data.uid.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'editor', 'user'];
    }

    function isValidReflection(data) {
      let fields = ['verseRef', 'entries', 'authorId', 'authorName', 'createdAt', 'isPublic'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields) &&
             data.verseRef is string && data.verseRef.size() > 0 && data.verseRef.size() < 100 &&
             data.entries is list && data.entries.size() > 0 && data.entries.size() <= 20 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() > 0 &&
             data.createdAt is timestamp &&
             data.isPublic is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
    }

    match /reflections/{reflectionId} {
      allow read: if resource.data.isPublic == true || (isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && isValidReflection(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin()) && isValidReflection(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
